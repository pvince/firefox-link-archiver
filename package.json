{
  "name": "firefox-archivebox-sync",
  "version": "0.3.0",
  "description": "Firefox WebExtension for syncing browser history & bookmarks to ArchiveBox",
  "type": "module",
  "scripts": {
    "build": "node build.cjs",
    "watch": "node build.cjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "node scripts/package.js",
    "package-source": "node scripts/package-source.js",
    "clean": "rm -rf dist && rm -rf *.crx && rm -rf *.xpi"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "archiver": "^6.0.2",
    "esbuild": "^0.28.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "firefox",
    "extension",
    "archivebox",
    "history",
    "bookmarks",
    "sync"
  ],
  "author": "",
  "license": "MIT"
}
