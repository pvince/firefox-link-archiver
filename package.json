{
  "name": "firefox-archivebox-sync",
  "version": "0.3.0",
  "description": "Firefox WebExtension for syncing browser history & bookmarks to ArchiveBox",
  "type": "module",
  "scripts": {
    "build": "node build.cjs",
    "watch": "node build.cjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "package": "node scripts/package.js",
    "package-source": "node scripts/package-source.js",
    "clean": "rm -rf dist && rm -rf *.crx && rm -rf *.xpi"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/firefox-webext-browser": "^143.0.1",
    "@types/jest": "^30.0.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.2"
  },
  "keywords": [
    "firefox",
    "extension",
    "archivebox",
    "history",
    "bookmarks",
    "sync"
  ],
  "author": "",
  "license": "MIT"
}
